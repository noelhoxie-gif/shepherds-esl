# Used only by the Vercel server function in /api/portal.js. Never put these in HTML.
SUPABASE_URL=https://your-project-id.supabase.co
# Prefer the secret key here. It stays on the server and is not sent to the browser.
SUPABASE_SECRET_KEY=your-secret-key
# Optional fallback if you only have the older anon/public key:
# SUPABASE_ANON_KEY=your-anon-key
# Optional. If set, attendance requests email through Resend.
# RESEND_API_KEY=re_xxxxxxxxx
# ATTENDANCE_NOTIFY_EMAIL=noel.hoxie@gmail.com,larryphoxie@gmail.com
# Optional. Public Web3Forms access key (safe in the browser). Get one at https://web3forms.com
# WEB3FORMS_ACCESS_KEY=your-access-key
