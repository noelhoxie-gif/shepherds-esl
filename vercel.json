{
  "buildCommand": "node scripts/write-config.js",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/volunteer", "destination": "/volunteer.html" },
    { "source": "/core-values", "destination": "/core-values.html" },
    { "source": "/esl-leadership", "destination": "/esl-leadership.html" },
    { "source": "/class-calendar", "destination": "/class-calendar.html" },
    { "source": "/bible-studies", "destination": "/bible-studies.html" },
    { "source": "/week-off", "destination": "/week-off.html" },
    { "source": "/curriculum", "destination": "/curriculum.html" },
    { "source": "/teacher-training", "destination": "/teacher-training.html" },
    { "source": "/tutor-training", "destination": "/tutor-training.html" }
  ],
  "headers": [
    {
      "source": "/(login.html|login|volunteer.html|core-values.html|core-values|esl-leadership.html|esl-leadership|class-calendar.html|bible-studies.html|week-off.html|curriculum.html|teacher-training.html|tutor-training.html|volunteer|class-calendar|bible-studies|week-off|curriculum|teacher-training|tutor-training)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
